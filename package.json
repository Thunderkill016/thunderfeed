{
  "name": "thunderfeed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "tsx --test tests/*.test.ts",
    "quality": "npm run typecheck && npm test && npm run build",
    "bench": "tsx scripts/bench/run.ts",
    "alerts:telegram": "tsx scripts/telegram-alerts.mts",
    "bench:lineage": "tsx scripts/bench/lineage.ts",
    "bench:lineage:real": "tsx scripts/bench/lineage.ts bench/lineage-real.jsonl",
    "bench:export": "tsx scripts/bench/export-pairs.ts",
    "bench:label": "tsx scripts/bench/label.ts",
    "bench:resolver:v2": "tsx scripts/bench/resolver-v2.ts",
    "bench:semantic": "tsx scripts/bench/semantic-dist.ts"
  },
  "dependencies": {
    "entities": "^8.1.0",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
