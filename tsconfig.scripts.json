{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "incremental": false,
    "jsx": "react-jsx"
  },
  "include": ["scripts/**/*.mts", "scripts/**/*.d.ts", "lib/**/*.ts"],
  "exclude": ["node_modules"]
}
